# Copy to .env.local for local development. Never commit real secrets.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by some setups:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App URL (emails / absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron routes (`/api/cron/*`) — Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Brevo transactional email (optional until you enable sends)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Fantasy Kings

# Database (Drizzle / local or pooled Supabase Postgres)
DATABASE_URL=
# Direct connection (Drizzle Kit only for migrations/push/studio)
DIRECT_URL=
