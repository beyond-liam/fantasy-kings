# Copy to .env.local for local development. Never commit real secrets.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by some setups:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App URL (emails / absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron routes (`/api/cron/*`) — Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Brevo transactional email (optional until you enable sends)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Fantasy Kings

# Database — prefer the transaction pooler (port 6543) at runtime.
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# If the pooler resets TLS (ECONNRESET), temporarily use the direct host for local recovery:
#   postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
# Keep max:1 in lib/db.ts when on direct — free-tier session slots are scarce.
DATABASE_URL=
# Direct connection (port 5432 on db.[ref].supabase.co) — drizzle-kit migrate/push/studio.
# Do not point this at the pooler host.
DIRECT_URL=
